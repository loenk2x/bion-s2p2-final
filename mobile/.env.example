# Copy to .env and fill in the server's LAN address.
#
# A physical device (or a physical-device-like emulator) cannot reach
# "localhost" - that resolves to the device itself, not the computer running
# `npm run dev` inside server/. Use that computer's LAN IP address instead,
# found with `ipconfig` (Windows) or `ifconfig`/`ip addr` (macOS/Linux).
# Both devices must be on the same network.
EXPO_PUBLIC_API_URL=http://192.168.1.23:4000
